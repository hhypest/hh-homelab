# =============================================================================
#  media/.env.example — переименуйте в .env.
#
#  БЕЗ ЭТОГО ФАЙЛА СТЕК НЕ ПОДНИМЕТСЯ, и это сделано намеренно. Значений
#  по умолчанию в compose.yaml нет: репозиторий публичный, и чужие настройки
#  не должны подставляться молча. Забыли .env — `docker compose up` упадёт
#  и назовёт первую недостающую переменную.
#
#  Compose читает .env из каталога рядом с compose.yaml. Сам .env
#  в .gitignore и в репозиторий не попадёт: настройки конкретной машины
#  не место в общей истории.
#
#  Создать по SSH:
#      cd /volume1/docker/hh-homelab/media && sudo cp .env.example .env
#  Container Manager дотфайлы в интерфейсе не создаёт; в File Station файл
#  виден при включённом показе скрытых файлов.
# =============================================================================

# --- Пользователь, права, время ----------------------------------------------
# Свои узнать по SSH: id ваш_логин
# Этот же пользователь должен владеть каталогом библиотеки и каталогами
# состояния, иначе контейнеры не смогут в них писать.
PUID=1026
PGID=100

# Права на создаваемые файлы: 002 даёт группе запись — Radarr и qBittorrent
# работают с одними и теми же файлами.
UMASK=002

# Часовой пояс контейнеров. Влияет на время в журналах, в расписаниях
# Radarr и в уведомлениях. Список: https://ru.wikipedia.org/wiki/TZ
TZ=Europe/Moscow

# --- Библиотека ---------------------------------------------------------------
# Корень медиатеки. Внутрь монтируются torrents/ и media/.
#
# Должен лежать ВНЕ клона репозитория: рабочее дерево git — это то, что чистят,
# а `git clean -xdf` не щадит и игнорируемое.
#
# Торренты и библиотека обязаны быть на одном томе, иначе Radarr не сможет
# импортировать хардлинком и начнёт копировать файлы — место уйдёт вдвое
# быстрее, а импорт растянется на минуты.
#
# Внутри контейнеров путь не меняется никогда: там всегда /data.
MEDIA_ROOT=/volume1/data

# --- Сеть ---------------------------------------------------------------------
# На каком адресе публиковать порты:
#   0.0.0.0   — вся домашняя сеть (обычный вариант для NAS);
#   127.0.0.1 — только сам NAS, если впереди стоит обратный прокси.
BIND_ADDR=0.0.0.0

# Адрес NAS в домашней сети. Jellyfin сообщает его клиентам, чтобы приложения
# на телевизоре и приставке находили сервер сами. Должен быть постоянным —
# закрепите его за NAS в DHCP роутера.
NAS_HOST=192.168.3.53

# Имя сети Docker. Менять, только если такое имя уже занято другим проектом.
MEDIA_NETWORK=media

# --- Порты --------------------------------------------------------------------
# Меняйте, если порт уже занят. DSM держит 5000 и 5001.
# После правки нужен `docker compose up -d`: перезапуск публикацию не меняет.
#
# ВАЖНО: это порты ХОСТА. Внутри контейнеров номера не меняются — там всегда
# 9080, 9696, 7878, 8191, 8096, 5055. Поэтому при смене порта адреса вида
# `radarr:7878`, которые вы вводите в настройках самих сервисов, остаются
# прежними: правится только то, что набирается в браузере.
#
# А вот Home Assistant опрашивает сервисы именно по портам хоста —
# http://127.0.0.1:<порт> в config/packages/monitoring.yaml и media_tv.yaml.
# Меняете порт здесь — поправьте и там, иначе сенсор уйдёт в «не отвечает»
# и Пачка пришлёт тревогу про живой контейнер. Тест test_env_example.py
# такое расхождение ловит.
QBITTORRENT_WEBUI_PORT=9080
PROWLARR_PORT=9696
RADARR_PORT=7878
FLARESOLVERR_PORT=8191
JELLYFIN_PORT=8096
SEERR_PORT=5055

# Порт раздачи — единственный, который меняется с ОБЕИХ сторон. qBittorrent
# объявляет пирам тот номер, на котором слушает, и на роутере пробрасывается
# он же; разъедутся — входящих соединений не будет вовсе, и раздача пойдёт
# только тем, кому вы отдаёте сами.
QBITTORRENT_TORRENT_PORT=6881

# UDP, автопоиск сервера клиентами в локальной сети. 7359 — фиксированный
# порт протокола: клиенты стучатся только в него. Менять есть смысл лишь
# если порт занят, и тогда автопоиск перестанет работать — сервер придётся
# прописывать в приложениях руками, по адресу.
JELLYFIN_DISCOVERY_PORT=7359
