# =============================================================================
#  /volume1/docker/homeassistant/config/secrets.yaml
#  Переименуйте этот файл в secrets.yaml и подставьте свои значения.
#  Файл НИКОГДА не должен попадать в git / публичные бэкапы.
#  chmod 600 secrets.yaml  (или в DSM: доступ только владельцу)
# =============================================================================

# --- Дом -----------------------------------------------------------------
# Координаты нужны для расчёта восхода/заката и присутствия.
home_latitude: 55.751244
home_longitude: 37.618423
home_elevation: 156

# --- Пачка ---------------------------------------------------------------
# Вебхук бота «Home Assistant» — того, что состоит в чате «Мониторинг»
# и БЕЗ Liquid-шаблона. Боты медиа-стека живут в чате «Кинозал», их
# вебхуки прописываются в самих Radarr, Prowlarr, Jellyfin и Seerr.
# Автоматизации → Интеграции → Чат-боты и Вебхуки → бот → «Входящий вебхук».
# Скопируйте URL целиком, вместе с токеном.
pachca_webhook_url: "https://api.pachca.com/webhooks/ВАШ_ТОКЕН_ВЕБХУКА"

# --- LG 32LK540BPLA ------------------------------------------------------
# MAC берётся из Keenetic (known host телевизор). Нужен для Wake-on-LAN.
tv_lg_mac: "AA:BB:CC:DD:EE:FF"
tv_lg_ip: "192.168.3.52"

# --- Внешний адрес (после настройки KeenDNS, шаг 9) ----------------------
ha_external_url: "https://ha.ВАШ-ДОМЕН.keenetic.pro"

# --- Android TV приставка RockTek GX1 ------------------------------------
androidtv_ip: "192.168.3.54"

# --- Jellyfin: нужен сценарию «Продолжить просмотр» ----------------------
# API-ключ: Jellyfin → Панель → Дополнительно → Ключи API → создать.
# Заголовок пишется целиком, вместе со словом MediaBrowser и кавычками.
jellyfin_auth_header: 'MediaBrowser Token="ВАШ_API_КЛЮЧ"'
# ID пользователя, чью очередь «продолжить» показываем. Как получить:
#   curl -s -H 'Authorization: MediaBrowser Token="КЛЮЧ"' \
#        http://192.168.3.53:8096/Users | python3 -m json.tool | grep -A1 '"Name"'
jellyfin_user_id: "00000000000000000000000000000000"