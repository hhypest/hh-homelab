# =============================================================================
#  homeassistant/.env.example — переименуйте в .env.
#
#  БЕЗ ЭТОГО ФАЙЛА СТЕК НЕ ПОДНИМЕТСЯ: значений по умолчанию в compose.yaml
#  нет намеренно. Забыли .env — `docker compose up` упадёт и назовёт
#  недостающую переменную, а не поднимется с пустыми значениями.
#
#  Это ОТДЕЛЬНЫЙ compose-проект, поэтому и .env у него свой: Compose читает
#  файл из каталога рядом с compose.yaml и в соседние не заглядывает.
#  Поэтому TZ указывается дважды — здесь и в media/.env.
#
#  Создать по SSH:
#      cd /volume1/docker/hh-homelab/homeassistant && sudo cp .env.example .env
#
#  Секреты Home Assistant живут не здесь, а в config/secrets.yaml —
#  см. config/secrets.yaml.example.
# =============================================================================

# Часовой пояс контейнеров. Home Assistant берёт свой из настроек интерфейса,
# но журналы контейнера и docker-socket-proxy смотрят сюда.
TZ=Europe/Moscow

# --- docker-socket-proxy -------------------------------------------------------
# Прокси отдаёт Docker API компоненту Monitor Docker — сам сокет в Home
# Assistant не пробрасывается, доступ к нему равносилен root на NAS.
#
# АДРЕС ПРИВЯЗКИ МЕНЯТЬ НЕ НУЖНО. 127.0.0.1 означает «только сам NAS»:
# Home Assistant работает в host-сети и достаёт прокси по петле.
# Поставить 0.0.0.0 — открыть Docker API всей домашней сети.
DOCKERPROXY_BIND=127.0.0.1

# Порт ХОСТА. Внутри контейнера прокси всегда слушает 2375. Если меняете,
# поправьте и адрес в homeassistant/config/packages/docker.yaml — Home
# Assistant ходит сюда по http://127.0.0.1:<этот порт>.
DOCKERPROXY_PORT=2375
